PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/sahakargig
JWT_SECRET=sahakargig_super_secret_change_me
CLIENT_ORIGIN=http://localhost:5173
# Razorpay — paste your keys from https://dashboard.razorpay.com/app/keys
# Test keys start with rzp_test_  |  Live keys start with rzp_live_
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Email (optional — in-app notifications work without this)
# Gmail: use an App Password (Google Account → Security → 2-Step Verification → App passwords)
EMAIL_USER=
EMAIL_PASS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# e-Shram Govt. Verification API
# DigiLocker OAuth endpoint — get from Ministry of Labour
ESHRAM_API_URL=https://api.digilocker.gov.in/public/eshram/verify
ESHRAM_API_KEY=<your_api_key_here>
ESHRAM_CLIENT_ID=<your_client_id_here>
ESHRAM_CLIENT_SECRET=<your_client_secret_here>
# UMANG API alternative (if using UMANG instead of DigiLocker)
UMANG_API_URL=https://api.umang.gov.in/eshram/verify
UMANG_API_KEY=<your_umang_api_key_here>