PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/sahakargig
JWT_SECRET=sahakargig_super_secret_change_me
CLIENT_ORIGIN=http://localhost:5173
# Razorpay — paste your keys from https://dashboard.razorpay.com/app/keys
# Test keys start with rzp_test_  |  Live keys start with rzp_live_
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Email (optional — in-app notifications work without this)
# Gmail: use an App Password (Google Account → Security → 2-Step Verification → App passwords)
EMAIL_USER=
EMAIL_PASS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# e-Shram Govt. Verification API (optional)
# Set ESHRAM_API_ENABLED=true only after you have real credentials from DigiLocker/UMANG
# During development, leave this false — mock verification will be used
ESHRAM_API_ENABLED=false
# DigiLocker OAuth credentials (from API Setu partner portal)
# Apply at: https://www.apisetu.gov.in/
ESHRAM_API_URL=
ESHRAM_API_KEY=
ESHRAM_CLIENT_ID=
ESHRAM_CLIENT_SECRET=