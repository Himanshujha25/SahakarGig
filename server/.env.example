PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/sahakargig
JWT_SECRET=sahakargig_super_secret_change_me
CLIENT_ORIGIN=http://localhost:5173
# Razorpay — paste your keys from https://dashboard.razorpay.com/app/keys
# Test keys start with rzp_test_  |  Live keys start with rzp_live_
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Email (optional — in-app notifications work without this)
# Gmail: use an App Password (Google Account → Security → 2-Step Verification → App passwords)
EMAIL_USER=
EMAIL_PASS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# e-Shram Govt. Verification API (optional)
# Set ESHRAM_API_ENABLED=true only after you have real credentials from DigiLocker/UMANG
# During development, leave this false — mock verification will be used
ESHRAM_API_ENABLED=false
# DigiLocker OAuth credentials (from API Setu partner portal)
# Apply at: https://www.apisetu.gov.in/
ESHRAM_API_URL=
ESHRAM_API_KEY=
ESHRAM_CLIENT_ID=
ESHRAM_CLIENT_SECRET=
# ── AI Assistant (Saarthi) — auto-fallback LLM providers ──
# Enable any combination; the server tries them in order and skips missing keys.
# 1) Groq (fast): https://console.groq.com/keys — models may need enabling at
#    https://console.groq.com/settings/limits (org admin)
GROQ_API_KEY=
# 2) Google Gemini: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# 3) OpenRouter (many free models): https://openrouter.ai/keys
OPENROUTER_API_KEY=
# 4) Hugging Face Inference: https://huggingface.co/settings/tokens
HF_API_KEY=
# Optional per-provider model overrides (otherwise built-in candidate lists are tried):
# GROQ_MODEL=openai/gpt-oss-120b
# GEMINI_MODEL=gemini-2.5-flash
# OPENROUTER_MODEL=deepseek/deepseek-chat-v3:free
# HF_MODEL=Qwen/Qwen2.5-7B-Instruct